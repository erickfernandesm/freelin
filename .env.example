# Banco PostgreSQL
# Local: postgresql://postgres:postgres@localhost:5432/freelin
# Neon/Supabase: use a URL com pooling em DATABASE_URL e a direta em DIRECT_URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freelin"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/freelin"

# Segredo da sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 48
AUTH_SECRET="troque-este-segredo-por-um-valor-longo-e-aleatorio"

# URL pública do app (usada em links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
